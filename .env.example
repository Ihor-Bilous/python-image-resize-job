# Mailtrap — API token from mailtrap.io → Settings → API Tokens
# Sandbox mode: token with access to your test inbox. Live mode: Email Sending token for your verified domain.
MAILTRAP_API_TOKEN=your_mailtrap_api_token

# true  = capture emails in a Mailtrap Sandbox inbox (requires MAILTRAP_INBOX_ID)
# false = send real emails via the Email Sending API
MAILTRAP_SANDBOX=true

# Numeric inbox ID from Email Testing → Inboxes → API tab (sandbox mode only)
MAILTRAP_INBOX_ID=your_sandbox_inbox_id

# Your verified sending domain in Mailtrap (any address works in sandbox mode)
MAIL_FROM=hello@yourdomain.com
MAIL_FROM_NAME=Image Resize Job

# Public origin used in emailed download links; set to a reachable address when deployed
APP_URL=http://localhost:8000

# SQLite file with resized images, hashed download tokens and rate-limit counters
DB_PATH=.data/app.sqlite

# Password for /admin (username: admin). Use 16+ random characters.
ADMIN_PASSWORD=
